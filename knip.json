{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,not-found,opengraph-image,sitemap,robots}.{ts,tsx}",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "scripts/**/*.mjs",
    "src/app/{sitemap,robots}.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "scripts/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "e2e/**/*.ts"
  ],
  "ignoreDependencies": [
    "tw-animate-css",
    "@tailwindcss/postcss",
    "tailwindcss",
    "postcss"
  ]
}
